# Prettier ignore list.
# Build output and dependencies are never formatted.
lib/
dist/
coverage/
node_modules/

# Local-only development context (gitignored).
.dev-docs/

# Lockfile is generated by pnpm; formatting it would create noisy diffs.
pnpm-lock.yaml

# Markdown carries hand-authored prose and tables; Prettier's reflowing would
# churn documentation for no benefit.
*.md
