{
  "name": "@melosic/dsh-dev-workflow",
  "version": "0.6.0",
  "description": "Project rules for DSH: check commit messages, PR descriptions and versions before they ship, and ask before destructive or outward-facing commands.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "dev-workflow",
    "conventional-commits",
    "workflow"
  ],
  "license": "MIT",
  "author": "Melosic",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./skills/*": "./skills/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20",
    "dsh": "0.2.0-rc.2 || 0.2.1-rc.2"
  },
  "packageManager": "pnpm@10.30.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Melosic/dsh-dev-workflow.git"
  },
  "homepage": "https://github.com/Melosic/dsh-dev-workflow#readme",
  "bugs": {
    "url": "https://github.com/Melosic/dsh-dev-workflow/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib/",
    "src/",
    "client.js",
    "skills/",
    "locale/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/with-src.mjs tsc -p tsconfig.json",
    "typecheck": "node scripts/with-src.mjs tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "node scripts/with-src.mjs tsc -p tsconfig.test.json",
    "typecheck:client": "node scripts/with-src.mjs tsc -p tsconfig.client.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "ci:checks": "node scripts/ci-checks.mjs",
    "token:probe": "node scripts/token-probe.mjs",
    "prepack": "pnpm build && pnpm ci:checks",
    "prepublishOnly": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm typecheck:tests && pnpm typecheck:client && pnpm test && pnpm build && pnpm ci:checks",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
