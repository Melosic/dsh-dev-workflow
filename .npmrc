# The package declares peerDependencies on @deepseek-ai/dsh* to express the
# supported runtime window (see .dev-docs/DSH-API-NOTES.md §15.2). During local
# development those peers are installed so TypeScript can resolve their types.
auto-install-peers=true

# DSH itself validates peerDependencies at install time; pnpm's stricter check
# would additionally reject ranges the DSH runtime accepts.
strict-peer-dependencies=false

# Keep the lockfile deterministic across the Node versions this repo supports.
resolution-mode=highest
